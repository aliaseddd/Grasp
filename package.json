{
  "name": "grasp",
  "private": true,
  "description": "Grasp, a SysML v2 design canvas opened from disk: the new page's build, checks and tests.",
  "scripts": {
    "build": "node canvas/app/build.mjs",
    "check": "node canvas/app/build.mjs --check && tsc -p canvas/app",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 canvas/app/test/*.test.mjs",
    "shots": "node canvas/app/test/shots.mjs",
    "test:old": "node --test --test-timeout=120000 canvas/test/*.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/x-tree-view": "8.29.3",
    "@xyflow/react": "12.10.2",
    "dockview-react": "8.9.0",
    "elkjs": "0.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "typescript": "6.0.2"
  },
  "overrides": {
    "dockview": "8.9.0",
    "dockview-core": "8.9.0"
  }
}
