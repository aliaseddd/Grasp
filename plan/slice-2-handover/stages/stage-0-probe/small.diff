+/**
+ * Whether a line can be drawn in a view: its kind's tools hold a relationship kind (a general view's do; a geometry
+ * view's do not). False for a view the model does not hold. The plane asks it for `data-grips` (slice 2, seam 6), so
+ * that no component reads a view's record.
+ */
+export function drawsLines(session: Session, viewId: string): boolean {
+  const view = session.model.views.find((v) => v.id === viewId);
+  return !!view && toolGroups(session.lib, view.kind).some((group) => group.some((tool) => tool.type === 'rel'));
