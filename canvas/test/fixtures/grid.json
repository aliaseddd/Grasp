    "package": {
      "name": "StrongholdProof",
      "doc": "One app, built once with current tools, and thin hosts that load it into a page the same way. The names follow the code: app/, hosts/server, hosts/online, hosts/dev."
    },
    "elements": [
      {
        "id": "Page",
        "kind": "PartDefinition",
        "name": "Page",
        "doc": "A page with Stronghold on it: a SharePoint Server page, a SharePoint Online page, a Teams tab, or the dev page. Every Stronghold web part on the page mounts the same app, because the first entry file to load wins (app/src/host/load-app.ts).",
        "abstract": false
      },
      {
        "id": "Page.hosts",
