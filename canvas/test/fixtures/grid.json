      },
      {
        "id": "StrongholdApp",
        "kind": "PortDefinition",
        "name": "StrongholdApp",
        "doc": "What the app's entry file registers on window.Stronghold.",
        "abstract": false
      },
      {
        "id": "ServerHost",
        "kind": "PartDefinition",
        "name": "ServerHost",
        "doc": "hosts/server: the web part for SharePoint Server.",
        "abstract": false
      },
      {
        "id": "OnlineHost",
        "kind": "PartDefinition",
        "name": "OnlineHost",
        "doc": "hosts/online: the web part for SharePoint Online, which is also the Teams tab.",
        "abstract": false
      },
      {
        "id": "DevHost",
        "kind": "PartDefinition",
        "name": "DevHost",
        "doc": "hosts/dev: a plain page that mounts the app the way the SharePoint hosts do. It never ships.",
        "abstract": false
      }
