        "conjugated": false
      },
      {
        "id": "Host",
        "kind": "PartDefinition",
        "name": "Host",
        "doc": "hosts/: the small piece of code that plugs the app into one place. It works out where its package's files are, loads the entry file with the shared loader, and calls mount. It has no settings: it only ever loads the app from its own package.",
        "abstract": true
      },
      {
        "id": "Host.api",
        "kind": "PortUsage",
        "name": "api",
        "doc": "",
        "owner": "Host",
        "multiplicity": "",
        "conjugated": true
      },
      {
        "id": "App",
        "kind": "PartDefinition",
        "name": "App",
        "doc": "app/: Stronghold itself, built once with webpack 5 and TypeScript 5.9. Nothing in it knows about SharePoint.",
        "abstract": false
      },
      {
        "id": "App.api",
        "kind": "PortUsage",
        "name": "api",
        "doc": "",
        "owner": "App",
        "multiplicity": "",
