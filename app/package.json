{
  "name": "stronghold-app",
  "version": "0.1.0",
  "private": true,
  "description": "Stronghold, the app: the shell, the modules, and the contract its hosts use. Built once with current tools. A host in ../hosts plugs the build into each place.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:host": "node scripts/check-host-files.mjs",
    "test": "npm run typecheck && npm run check:host"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0"
  },
  "devDependencies": {
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-2.4": "npm:typescript@2.4.2",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  }
}
