{
  "name": "stronghold-host-server",
  "version": "0.1.0",
  "private": true,
  "description": "The Stronghold web part for SharePoint Server (SPFx 1.4.1). Loads the app built in ../../app.",
  "main": "lib/index.js",
  "engines": {
    "node": ">=8.0.0 <9.0.0"
  },
  "scripts": {
    "prepare-shared": "node scripts/prepare-shared.js",
    "build": "gulp clean && node scripts/prepare-shared.js && gulp bundle --ship && node scripts/copy-app.js && gulp package-solution --ship",
    "clean": "gulp clean"
  },
  "dependencies": {
    "@microsoft/sp-core-library": "1.4.1",
    "@microsoft/sp-webpart-base": "1.4.1",
    "@microsoft/sp-lodash-subset": "1.4.1",
    "@microsoft/sp-office-ui-fabric-core": "1.4.1",
    "@types/webpack-env": "1.13.1",
    "@types/es6-promise": "0.0.33"
  },
  "devDependencies": {
    "@microsoft/sp-build-web": "1.4.1",
    "@microsoft/sp-module-interfaces": "1.4.1",
    "@microsoft/sp-webpart-workbench": "1.4.1",
    "gulp": "~3.9.1",
    "@types/chai": "3.4.34",
    "@types/mocha": "2.2.38",
    "ajv": "~5.2.2"
  }
}
